# Neon Postgres — add the "Neon" integration in Vercel's Storage tab; it
# auto-fills this. Works with any standard Postgres connection string.
DATABASE_URL=

# Random secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this logs every user out (all sessions become unverifiable).
SESSION_SECRET=

# Vercel Blob — add the "Blob" integration in Vercel's Storage tab; it
# auto-fills this. Used for private KYC/case document storage.
BLOB_READ_WRITE_TOKEN=

# Google OAuth ("Continue with Google") — from a Google Cloud Console
# project's OAuth 2.0 Client ID (Web application type). Add
# https://app.alphasaxis.com/api/auth/google/callback (and your local dev
# URL) as an authorized redirect URI. Without these set, the button
# redirects back with a "not configured" message instead of erroring.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
