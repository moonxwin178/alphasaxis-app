// AlphasAxis Super App — core schema (Phase A: identity, KYC, cases, points ledger)
// Money-adjacent entities (Commission, PayoutRequest, Dispute) are modeled now
// even though Phase A's UI doesn't expose them yet, so no later migration is needed.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  AGENT
  AGENCY
  LOAN_CONSULTANT
  ADMIN
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  MISMATCH
}

enum KycDocType {
  NRIC_PASSPORT
  SELFIE
  PROOF_OF_ADDRESS
}

enum KycDocStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum NftTier {
  AXIS_ZERO
  AXIS_ONE
  AXIS_PRO
  AXIS_PRESTIGE
}

enum CaseStatus {
  SUBMITTED
  ASSIGNED
  DOCS
  REVIEW
  APPROVED
  DISBURSED
  FLAGGED
}

enum FinancingType {
  MORTGAGE
  HIRE_PURCHASE
  PERSONAL
  BUSINESS
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PointsReason {
  SPEND_TO_EARN
  SUBMIT_TO_EARN
  NETWORK_TO_EARN
  SOCIAL_TO_EARN
  CONSULTATION
  REFERRAL_BONUS
  VOUCHER_REDEMPTION
  SERVICE_REQUEST
  ADMIN_ADJUST
}

enum ServicePaymentMethod {
  RM
  USDT
  AXIS_POINTS
}

enum ServiceRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

enum NftVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum CommissionTier {
  TIER_1
  TIER_2
}

enum MembershipCommissionStatus {
  PENDING
  PAID
}

enum WalletTopUpMethod {
  RM
  USDT
}

enum WalletTopUpStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WalletReason {
  TOPUP
  AGENT_MEMBERSHIP
  AGENCY_MEMBERSHIP
  AGENCY_MEMBERSHIP_REFUND
  ADMIN_ADJUST
}

enum AgencyAgentStatus {
  INVITED
  ACTIVE
  REMOVED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  PAID
  REJECTED
}

enum DisputeStatus {
  OPEN
  INVESTIGATING
  RESOLVED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  phone         String?
  role          Role      @default(USER)
  referralCode  String    @unique
  referredById  String?
  referredBy    User?     @relation("Referrals", fields: [referredById], references: [id])
  referredUsers User[]    @relation("Referrals")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions        Session[]
  kycSubmission   KycSubmission?
  nftHoldings     NftHolding[]
  agentProfile    AgentProfile?
  ownedAgency     Agency?              @relation("AgencyOwner")
  agencyAgentRows AgencyAgent[]        @relation("AgencyAgentUser")
  applicantCases  Case[]               @relation("CaseApplicant")
  consultantCases Case[]               @relation("CaseConsultant")
  commissionLineItems CommissionLineItem[]
  caseEvents      CaseEvent[]
  documents       Document[]           @relation("DocumentUploader")
  reviewedDocs    Document[]           @relation("DocumentReviewer")
  reviewedKyc     KycSubmission[]      @relation("KycReviewer")
  pointsLedger    PointsLedgerEntry[]
  receiptUploads  ReceiptUpload[]
  checkIns        CheckIn[]
  orders          Order[]
  serviceRequests ServiceRequest[]
  payoutRequests  PayoutRequest[]
  disputesRaised  Dispute[]            @relation("DisputeRaisedBy")
  disputesHandled Dispute[]            @relation("DisputeResolvedBy")
  roleApplications RoleApplication[]
  commissionsEarned MembershipCommission[] @relation("MembershipCommissionRecipient")
  commissionsSourced MembershipCommission[] @relation("MembershipCommissionSource")
  walletTopUps      WalletTopUpRequest[]
  walletLedger      WalletLedgerEntry[]
  axisMiningSubmissions     AxisMiningSubmission[]         @relation("MiningSubmissionUser")
  reviewedMiningSubmissions AxisMiningSubmission[]         @relation("MiningSubmissionReviewer")
  axisVestingLedger         AxisVestingLedgerEntry[]
  axisPrestigeLines         AxisPrestigeDistributionLine[]

  @@index([role])
}

// Database session, per Auth.js Credentials + database-session pattern.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model AgentProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agencyId          String?
  agency            Agency?  @relation(fields: [agencyId], references: [id])
  conversionScore   Int      @default(0)
  responseTimeScore Int      @default(0)
  complianceScore   Int      @default(0)
  trainingScore     Int      @default(0)
  updatedAt         DateTime @updatedAt

  assignedCases Case[] @relation("CaseAgent")
}

model Agency {
  id        String   @id @default(cuid())
  name      String
  ownerId   String   @unique
  owner     User     @relation("AgencyOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())

  agents      AgentProfile[]
  agencyAgent AgencyAgent[]
  commissions Commission[]
}

model AgencyAgent {
  id        String            @id @default(cuid())
  agencyId  String
  agency    Agency            @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation("AgencyAgentUser", fields: [userId], references: [id])
  status    AgencyAgentStatus @default(INVITED)
  invitedAt DateTime          @default(now())

  @@unique([agencyId, userId])
}

model KycSubmission {
  id             String        @id @default(cuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         KycStatus     @default(NOT_SUBMITTED)
  reviewedById   String?
  reviewer       User?         @relation("KycReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  rejectionReason String?
  submittedAt    DateTime?
  createdAt      DateTime      @default(now())

  documents KycDocument[]
}

model KycDocument {
  id              String        @id @default(cuid())
  kycSubmissionId String
  kycSubmission   KycSubmission @relation(fields: [kycSubmissionId], references: [id], onDelete: Cascade)
  docType         KycDocType
  blobPath        String
  status          KycDocStatus  @default(PENDING)
  uploadedAt      DateTime      @default(now())
}

model NftHolding {
  id                  String                 @id @default(cuid())
  userId              String
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier                NftTier
  multiplier          Float
  chain               String                 @default("off-chain") // beta default: off-chain record, see plan risk flag on chain confirmation
  walletAddress       String? // set for AxisPrestige node claims, verified against app.turbox.bond/node-pad
  verificationStatus  NftVerificationStatus  @default(VERIFIED) // node claims start PENDING until an admin confirms on-chain ownership
  mintedAt            DateTime               @default(now())

  @@index([userId])
}

model Case {
  id            String        @id @default(cuid())
  applicantId   String
  applicant     User          @relation("CaseApplicant", fields: [applicantId], references: [id])
  agentId       String?
  agent         AgentProfile? @relation("CaseAgent", fields: [agentId], references: [id])
  financingType FinancingType
  amount        Decimal       @db.Decimal(14, 2)
  status        CaseStatus    @default(SUBMITTED)

  // Commission-distribution fields. introducerTier is snapshotted the
  // moment an agent is assigned, so a later NFT upgrade can't retroactively
  // change an already-submitted deal's split (matches the confirmed rule:
  // "unless they mint before submission").
  introducerTier BrokerageTier?
  servicingMode  ServicingMode  @default(UNDECIDED)
  consultantId   String?
  consultant     User?          @relation("CaseConsultant", fields: [consultantId], references: [id])
  grossCommission Decimal?      @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events            CaseEvent[]
  documents         Document[]
  commissions       Commission[]
  commissionLines   CommissionLineItem[]
  treasuryEntries   TreasuryLedgerEntry[]

  @@index([applicantId])
  @@index([agentId])
  @@index([consultantId])
  @@index([status])
}

enum BrokerageTier {
  AXIS_ZERO
  AXIS_ONE
  AXIS_PRO
}

// UNDECIDED until admin/agent settle whether the introducer self-services
// the case or needs an internal Loan Consultant — this directly drives the
// commission engine's isSelfClosed calculation, not just a workflow label.
enum ServicingMode {
  UNDECIDED
  SELF_SERVICED
  NEEDS_CONSULTANT
}

model CaseEvent {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  type      String
  note      String?
  createdAt DateTime @default(now())

  @@index([caseId])
}

model Document {
  id           String         @id @default(cuid())
  caseId       String?
  case         Case?          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploaderId   String
  uploader     User           @relation("DocumentUploader", fields: [uploaderId], references: [id])
  docType      String
  blobPath     String
  status       DocumentStatus @default(PENDING)
  reviewedById String?
  reviewer     User?          @relation("DocumentReviewer", fields: [reviewedById], references: [id])
  createdAt    DateTime       @default(now())

  @@index([caseId])
}

model PointsLedgerEntry {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Int
  reason    PointsReason
  refId     String?
  createdAt DateTime     @default(now())

  @@index([userId])
}

model ReceiptUpload {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  blobPath      String
  status        DocumentStatus @default(PENDING)
  pointsAwarded Int?
  createdAt     DateTime @default(now())
}

model CheckIn {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  streakCount  Int

  @@unique([userId, date])
}

model Voucher {
  id          String  @id @default(cuid())
  title       String
  description String
  costPoints  Int
  active      Boolean @default(true)

  orders Order[]
}

model Order {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  voucherId String
  voucher   Voucher  @relation(fields: [voucherId], references: [id])
  createdAt DateTime @default(now())
}

model ServiceRequest {
  id            String                @id @default(cuid())
  userId        String
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceSlug   String
  serviceTitle  String
  paymentMethod ServicePaymentMethod
  pointsCost    Int?
  status        ServiceRequestStatus  @default(PENDING)
  createdAt     DateTime              @default(now())

  @@index([userId])
}

model Commission {
  id           String            @id @default(cuid())
  caseId       String
  case         Case              @relation(fields: [caseId], references: [id])
  agentId      String
  agencyId     String?
  agency       Agency?           @relation(fields: [agencyId], references: [id])
  amount       Decimal           @db.Decimal(14, 2)
  status       CommissionStatus  @default(PENDING)
  approvedById String?
  computedAt   DateTime          @default(now())

  @@index([caseId])
}

enum CommissionLineRole {
  AES
  TREASURY
  LEAD_PROVIDER
  CALLER
  CLOSER
  OVERRIDE_INTRODUCER
  OVERRIDE_UPLINE
  OVERRIDE_PLATFORM
  OVERRIDE_CONSULTANT
}

// One row per party per disbursed case — the output of
// computeCommissionDistribution() (see src/lib/commissionEngine.ts),
// persisted. recipientId is null for house lines (AES, Treasury, platform).
model CommissionLineItem {
  id           String             @id @default(cuid())
  caseId       String
  case         Case               @relation(fields: [caseId], references: [id])
  role         CommissionLineRole
  recipientId  String?
  recipient    User?              @relation(fields: [recipientId], references: [id])
  amount       Decimal            @db.Decimal(14, 2)
  status       CommissionStatus   @default(PENDING)
  approvedById String?
  computedAt   DateTime           @default(now())

  @@index([caseId])
  @@index([recipientId])
}

// Running ledger of the tier-gap (the difference between a lower tier's
// team share and AxisPro's "top" 70%) banked out of every case, per the
// confirmed rule. Recorded in fiat terms only — converting any of this to
// BTC/ETH/BNB/PLS is a real trade a human executes, never automated here.
model TreasuryLedgerEntry {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id])
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())

  @@index([caseId])
}

model PayoutRequest {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  amount       Decimal      @db.Decimal(14, 2)
  status       PayoutStatus @default(REQUESTED)
  approvedById String?
  paidAt       DateTime?
  createdAt    DateTime     @default(now())
}

model RoleApplication {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedRole Role
  agencyName    String?
  walletAddress String? // wallet used for the $500 (Agent) / $5,000 (Agency) USDT mint, pending real on-chain verification
  status        ApplicationStatus  @default(PENDING)
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime           @default(now())

  @@index([userId])
}

// Records the 10% (Tier 1, direct referrer) / 5% (Tier 2, referrer's referrer)
// USDT commission owed when a referred user mints Agent or Agency. Paid out
// manually by an admin for now — see risk flag on custodial USDT payouts.
model MembershipCommission {
  id             String                      @id @default(cuid())
  recipientId    String
  recipient      User                        @relation("MembershipCommissionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  sourceUserId   String
  sourceUser     User                        @relation("MembershipCommissionSource", fields: [sourceUserId], references: [id], onDelete: Cascade)
  mintedRole     Role
  tier           CommissionTier
  usdtAmount     Decimal                     @db.Decimal(14, 2)
  status         MembershipCommissionStatus  @default(PENDING)
  createdAt      DateTime                    @default(now())

  @@index([recipientId])
}

// A user's request to add real money to their in-app USD balance. Nothing is
// actually charged here — no payment gateway is wired up yet. An admin
// confirms the payment came in (bank transfer / USDT deposit) and approves,
// which is what credits WalletLedgerEntry.
model WalletTopUpRequest {
  id           String              @id @default(cuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountUsd    Decimal             @db.Decimal(14, 2)
  method       WalletTopUpMethod
  note         String?
  status       WalletTopUpStatus   @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime            @default(now())

  @@index([userId])
}

// Append-only USD ledger — same idempotent pattern as PointsLedgerEntry.
// Balance = SUM(delta). Only approved top-ups and membership spends land here.
model WalletLedgerEntry {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Decimal       @db.Decimal(14, 2)
  reason    WalletReason
  refId     String?
  createdAt DateTime      @default(now())

  @@index([userId])
}

model Dispute {
  id             String        @id @default(cuid())
  raisedById     String
  raisedBy       User          @relation("DisputeRaisedBy", fields: [raisedById], references: [id])
  subjectType    String
  subjectId      String
  note           String
  status         DisputeStatus @default(OPEN)
  resolutionNote String?
  resolvedById   String?
  resolvedBy     User?         @relation("DisputeResolvedBy", fields: [resolvedById], references: [id])
  createdAt      DateTime      @default(now())
}

// ============================================================================
// Agent2Mine — Spend-to-Earn $AXIS mining, separate from the gamified
// PointsLedgerEntry system above. Real numbers confirmed: Agent2Mine
// Incentive Pool = 32% of 178B total $AXIS supply = 56.96B tokens, anchor
// price $0.0005 for this pool specifically, 60-month (5yr) vesting horizon.
// See src/lib/axisEmission.ts for the sinking-fund emission math this
// ledger feeds into.
// ============================================================================

enum AxisMiningTaskType {
  PETROL_RECEIPT
  META_ADS_ONBOARDING
}

enum AxisMiningStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED_DUPLICATE
}

enum MetaAdsCategory {
  PROPERTY_LOAN_LEADGEN
  GENERAL
}

enum AxisLedgerSource {
  AGENT2MINE_TASK
  AXISPRESTIGE_QUARTERLY
  ADMIN_ADJUST
}

// One row per Spend-to-Earn submission. Duplicate-receipt fraud detection
// (perceptualHash + receiptNumber, see src/lib/receiptFraud.ts) runs and can
// auto-flag before an admin ever reviews it. OCR-based field verification is
// NOT implemented — no vision API credentials — so merchantName/receiptNumber/
// subsidyAmountRm are user-entered and admin-verified against the uploaded
// image manually, same "pending manual review" pattern as KycSubmission.
model AxisMiningSubmission {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation("MiningSubmissionUser", fields: [userId], references: [id], onDelete: Cascade)
  taskType        AxisMiningTaskType
  status          AxisMiningStatus   @default(PENDING)
  blobPath        String

  // PETROL_RECEIPT fields
  merchantName    String?
  receiptNumber   String?
  subsidyAmountRm Decimal?           @db.Decimal(10, 2)
  perceptualHash  String?

  // META_ADS_ONBOARDING fields
  metaAdsCategory MetaAdsCategory?
  metaAdsSpendUsd Decimal?           @db.Decimal(10, 2)

  axisAwarded     Decimal?           @db.Decimal(18, 4)
  duplicateOfId   String?
  reviewedById    String?
  reviewer        User?              @relation("MiningSubmissionReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime           @default(now())

  @@index([userId])
  @@index([perceptualHash])
  @@index([receiptNumber])
  @@index([status])
}

// Append-only $AXIS earnings ledger — same idempotent SUM(delta) pattern as
// PointsLedgerEntry/WalletLedgerEntry. Balance here represents tokens earned
// but not yet distributed on-chain (no wallet/contract integration in beta).
model AxisVestingLedgerEntry {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Decimal          @db.Decimal(18, 4)
  source    AxisLedgerSource
  refId     String?
  createdAt DateTime         @default(now())

  @@index([userId])
}

// Single configuration row for the Agent2Mine sinking-fund emission model.
// totalPoolTokens/vestingMonths/anchorPriceUsd are the confirmed real
// numbers; startDate anchors "how many months have elapsed" for the
// RemainingMonths term. Admin-editable in principle, but beta ships with one
// seeded row — see src/lib/axisEmission.ts.
model AxisMiningPoolConfig {
  id              String   @id @default(cuid())
  totalPoolTokens Decimal  @db.Decimal(20, 4)
  vestingMonths   Int
  startDate       DateTime
  anchorPriceUsd  Decimal  @db.Decimal(10, 6)
  createdAt       DateTime @default(now())
}

// AxisPrestige quarterly distribution — a distinct mechanism from Agent2Mine
// task-based mining. Draws from the "Early Backers" allocation (18% of 178B
// = 32.04B tokens) and pays out to AxisPrestige node holders each quarter,
// not per-task.
model AxisPrestigeDistribution {
  id                     String                         @id @default(cuid())
  quarterLabel           String
  totalDistributedTokens Decimal                        @db.Decimal(20, 4)
  perNodeAmount          Decimal                        @db.Decimal(18, 4)
  createdById            String?
  createdAt              DateTime                       @default(now())

  lines AxisPrestigeDistributionLine[]
}

model AxisPrestigeDistributionLine {
  id             String                   @id @default(cuid())
  distributionId String
  distribution   AxisPrestigeDistribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  userId         String
  user           User                     @relation(fields: [userId], references: [id])
  nftHoldingId   String
  amount         Decimal                  @db.Decimal(18, 4)

  @@index([distributionId])
  @@index([userId])
}
