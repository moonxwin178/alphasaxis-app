// AlphasAxis Super App — core schema (Phase A: identity, KYC, cases, points ledger)
// Money-adjacent entities (Commission, PayoutRequest, Dispute) are modeled now
// even though Phase A's UI doesn't expose them yet, so no later migration is needed.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  AGENT
  AGENCY
  LOAN_CONSULTANT
  ADMIN
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  MISMATCH
}

enum KycDocType {
  NRIC_PASSPORT
  SELFIE
  PROOF_OF_ADDRESS
}

enum KycDocStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum NftTier {
  AXIS_ZERO
  AXIS_ONE
  AXIS_PRO
  AXIS_PRESTIGE
}

enum CaseStatus {
  SUBMITTED
  ASSIGNED
  DOCS
  REVIEW
  APPROVED
  DISBURSED
  FLAGGED
}

enum FinancingType {
  MORTGAGE
  HIRE_PURCHASE
  PERSONAL
  BUSINESS
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PointsReason {
  SPEND_TO_EARN
  SUBMIT_TO_EARN
  NETWORK_TO_EARN
  SOCIAL_TO_EARN
  CONSULTATION
  REFERRAL_BONUS
  VOUCHER_REDEMPTION
  SERVICE_REQUEST
  ADMIN_ADJUST
}

enum ServicePaymentMethod {
  RM
  USDT
  AXIS_POINTS
}

enum ServiceRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

enum NftVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum CommissionTier {
  TIER_1
  TIER_2
}

enum MembershipCommissionStatus {
  PENDING
  PAID
}

enum WalletTopUpMethod {
  RM
  USDT
}

enum WalletTopUpStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WalletReason {
  TOPUP
  AGENT_MEMBERSHIP
  AGENCY_MEMBERSHIP
  AGENCY_MEMBERSHIP_REFUND
  ADMIN_ADJUST
  AXISPRESTIGE_REVENUE_SHARE
  AES_NODE_POOL_SHARE
}

enum AgencyAgentStatus {
  INVITED
  ACTIVE
  REMOVED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  PAID
  REJECTED
}

enum DisputeStatus {
  OPEN
  INVESTIGATING
  RESOLVED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  phone         String?
  role          Role      @default(USER)
  referralCode  String    @unique
  referredById  String?
  referredBy    User?     @relation("Referrals", fields: [referredById], references: [id])
  referredUsers User[]    @relation("Referrals")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions        Session[]
  kycSubmission   KycSubmission?
  nftHoldings     NftHolding[]
  agentProfile    AgentProfile?
  ownedAgency     Agency?              @relation("AgencyOwner")
  agencyAgentRows AgencyAgent[]        @relation("AgencyAgentUser")
  applicantCases  Case[]               @relation("CaseApplicant")
  consultantCases Case[]               @relation("CaseConsultant")
  commissionLineItems CommissionLineItem[]
  caseEvents      CaseEvent[]
  documents       Document[]           @relation("DocumentUploader")
  reviewedDocs    Document[]           @relation("DocumentReviewer")
  reviewedKyc     KycSubmission[]      @relation("KycReviewer")
  pointsLedger    PointsLedgerEntry[]
  receiptUploads  ReceiptUpload[]
  checkIns        CheckIn[]
  orders          Order[]
  serviceRequests ServiceRequest[]
  payoutRequests  PayoutRequest[]
  disputesRaised  Dispute[]            @relation("DisputeRaisedBy")
  disputesHandled Dispute[]            @relation("DisputeResolvedBy")
  roleApplications RoleApplication[]
  commissionsEarned MembershipCommission[] @relation("MembershipCommissionRecipient")
  commissionsSourced MembershipCommission[] @relation("MembershipCommissionSource")
  walletTopUps      WalletTopUpRequest[]
  walletLedger      WalletLedgerEntry[]
  axisMiningSubmissions     AxisMiningSubmission[]         @relation("MiningSubmissionUser")
  reviewedMiningSubmissions AxisMiningSubmission[]         @relation("MiningSubmissionReviewer")
  axisVestingLedger         AxisVestingLedgerEntry[]
  axisPrestigeLines         AxisPrestigeDistributionLine[]
  axisPrestigeVestingLines  AxisPrestigeVestingRunLine[]
  axisPrestigeNodeVestings  AxisPrestigeNodeVesting[]
  axisRealizedValueEntries  AxisRealizedValueEntry[]
  miningPoolLedger          MiningPoolLedgerEntry[]
  aesNodePoolLines          AesNodePoolDistributionLine[]
  mintCycleLedger           MintCycleLedgerEntry[]
  claimVestingSchedules     AxisClaimVestingSchedule[]

  @@index([role])
}

// Database session, per Auth.js Credentials + database-session pattern.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model AgentProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agencyId          String?
  agency            Agency?  @relation(fields: [agencyId], references: [id])
  conversionScore   Int      @default(0)
  responseTimeScore Int      @default(0)
  complianceScore   Int      @default(0)
  trainingScore     Int      @default(0)
  updatedAt         DateTime @updatedAt

  assignedCases Case[] @relation("CaseAgent")
}

model Agency {
  id        String   @id @default(cuid())
  name      String
  ownerId   String   @unique
  owner     User     @relation("AgencyOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())

  agents      AgentProfile[]
  agencyAgent AgencyAgent[]
  commissions Commission[]
}

model AgencyAgent {
  id        String            @id @default(cuid())
  agencyId  String
  agency    Agency            @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation("AgencyAgentUser", fields: [userId], references: [id])
  status    AgencyAgentStatus @default(INVITED)
  invitedAt DateTime          @default(now())

  @@unique([agencyId, userId])
}

model KycSubmission {
  id             String        @id @default(cuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         KycStatus     @default(NOT_SUBMITTED)
  // ISO country name as entered at KYC time (e.g. "Malaysia"). Drives
  // region-gating for Agent2Mine Spend-to-Earn/Submit-to-Earn tasks — see
  // ALLOWED_MINING_COUNTRIES in src/lib/regionGate.ts. Malaysia-only at
  // launch, deliberately extensible as AlphasAxis opens up more of SEA.
  // Network-to-Earn/Social-to-Earn stay unrestricted since $AXIS itself is
  // on-chain and not country-bound.
  nationality    String?
  // Unique real-world identity number (NRIC/passport) — Sybil resistance.
  // One real identity, one account: nothing else in this app (per-account
  // Agent2Mine caps, referral rewards, etc.) means anything if one person
  // can register multiple accounts, so this is enforced with a DB-level
  // uniqueness constraint, not just a document photo review.
  identityNumber String?       @unique
  reviewedById   String?
  reviewer       User?         @relation("KycReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  rejectionReason String?
  submittedAt    DateTime?
  createdAt      DateTime      @default(now())

  documents KycDocument[]
}

model KycDocument {
  id              String        @id @default(cuid())
  kycSubmissionId String
  kycSubmission   KycSubmission @relation(fields: [kycSubmissionId], references: [id], onDelete: Cascade)
  docType         KycDocType
  blobPath        String
  status          KycDocStatus  @default(PENDING)
  uploadedAt      DateTime      @default(now())
}

model NftHolding {
  id                  String                 @id @default(cuid())
  userId              String
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier                NftTier
  multiplier          Float
  chain               String                 @default("off-chain") // beta default: off-chain record, see plan risk flag on chain confirmation
  walletAddress       String? // set for AxisPrestige node claims, verified against app.turbox.bond/node-pad
  verificationStatus  NftVerificationStatus  @default(VERIFIED) // node claims start PENDING until an admin confirms on-chain ownership
  mintedAt            DateTime               @default(now())

  // AxisPrestige only: how many nodes this specific wallet actually holds.
  // Multiple nodes per person are allowed and each gets its own
  // AxisPrestigeNodeVesting row (no multiplier stacking — just more
  // allocation), but they don't get a separate NftHolding row each; this
  // count is what admin verifies against the real on-chain wallet (no
  // blockchain integration yet, so this is a manual check, same as
  // everything else not yet wired to real chain data) before approval.
  claimedNodeCount    Int?

  @@index([userId])
}

model Case {
  id            String        @id @default(cuid())
  applicantId   String
  applicant     User          @relation("CaseApplicant", fields: [applicantId], references: [id])
  agentId       String?
  agent         AgentProfile? @relation("CaseAgent", fields: [agentId], references: [id])
  financingType FinancingType
  amount        Decimal       @db.Decimal(14, 2)
  status        CaseStatus    @default(SUBMITTED)

  // Commission-distribution fields. introducerTier is snapshotted the
  // moment an agent is assigned, so a later NFT upgrade can't retroactively
  // change an already-submitted deal's split (matches the confirmed rule:
  // "unless they mint before submission").
  introducerTier BrokerageTier?
  servicingMode  ServicingMode  @default(UNDECIDED)
  consultantId   String?
  consultant     User?          @relation("CaseConsultant", fields: [consultantId], references: [id])
  grossCommission Decimal?      @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events            CaseEvent[]
  documents         Document[]
  commissions       Commission[]
  commissionLines   CommissionLineItem[]
  treasuryEntries   TreasuryLedgerEntry[]

  @@index([applicantId])
  @@index([agentId])
  @@index([consultantId])
  @@index([status])
}

enum BrokerageTier {
  AXIS_ZERO
  AXIS_ONE
  AXIS_PRO
}

// UNDECIDED until admin/agent settle whether the introducer self-services
// the case or needs an internal Loan Consultant — this directly drives the
// commission engine's isSelfClosed calculation, not just a workflow label.
enum ServicingMode {
  UNDECIDED
  SELF_SERVICED
  NEEDS_CONSULTANT
}

model CaseEvent {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  type      String
  note      String?
  createdAt DateTime @default(now())

  @@index([caseId])
}

model Document {
  id           String         @id @default(cuid())
  caseId       String?
  case         Case?          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploaderId   String
  uploader     User           @relation("DocumentUploader", fields: [uploaderId], references: [id])
  docType      String
  blobPath     String
  status       DocumentStatus @default(PENDING)
  reviewedById String?
  reviewer     User?          @relation("DocumentReviewer", fields: [reviewedById], references: [id])
  createdAt    DateTime       @default(now())

  @@index([caseId])
}

model PointsLedgerEntry {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Int
  reason    PointsReason
  refId     String?
  createdAt DateTime     @default(now())

  @@index([userId])
}

model ReceiptUpload {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  blobPath      String
  status        DocumentStatus @default(PENDING)
  pointsAwarded Int?
  createdAt     DateTime @default(now())
}

model CheckIn {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  streakCount  Int

  @@unique([userId, date])
}

model Voucher {
  id          String  @id @default(cuid())
  title       String
  description String
  costPoints  Int
  active      Boolean @default(true)

  orders Order[]
}

model Order {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  voucherId String
  voucher   Voucher  @relation(fields: [voucherId], references: [id])
  createdAt DateTime @default(now())
}

model ServiceRequest {
  id            String                @id @default(cuid())
  userId        String
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceSlug   String
  serviceTitle  String
  paymentMethod ServicePaymentMethod
  pointsCost    Int?
  status        ServiceRequestStatus  @default(PENDING)
  createdAt     DateTime              @default(now())

  @@index([userId])
}

model Commission {
  id           String            @id @default(cuid())
  caseId       String
  case         Case              @relation(fields: [caseId], references: [id])
  agentId      String
  agencyId     String?
  agency       Agency?           @relation(fields: [agencyId], references: [id])
  amount       Decimal           @db.Decimal(14, 2)
  status       CommissionStatus  @default(PENDING)
  approvedById String?
  computedAt   DateTime          @default(now())

  @@index([caseId])
}

enum CommissionLineRole {
  AES
  TREASURY
  LEAD_PROVIDER
  CALLER
  CLOSER
  OVERRIDE_INTRODUCER
  OVERRIDE_UPLINE
  OVERRIDE_PLATFORM
  OVERRIDE_CONSULTANT
}

// One row per party per disbursed case — the output of
// computeCommissionDistribution() (see src/lib/commissionEngine.ts),
// persisted. recipientId is null for house lines (AES, Treasury, platform).
model CommissionLineItem {
  id           String             @id @default(cuid())
  caseId       String
  case         Case               @relation(fields: [caseId], references: [id])
  role         CommissionLineRole
  recipientId  String?
  recipient    User?              @relation(fields: [recipientId], references: [id])
  amount       Decimal            @db.Decimal(14, 2)
  status       CommissionStatus   @default(PENDING)
  approvedById String?
  computedAt   DateTime           @default(now())

  @@index([caseId])
  @@index([recipientId])
}

// Running ledger of the tier-gap (the difference between a lower tier's
// team share and AxisPro's "top" 70%) banked out of every case, per the
// confirmed rule. Recorded in fiat terms only — converting any of this to
// BTC/ETH/BNB/PLS is a real trade a human executes, never automated here.
model TreasuryLedgerEntry {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id])
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())

  @@index([caseId])
}

model PayoutRequest {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  amount       Decimal      @db.Decimal(14, 2)
  status       PayoutStatus @default(REQUESTED)
  approvedById String?
  paidAt       DateTime?
  createdAt    DateTime     @default(now())
}

enum MintPaymentMethod {
  WALLET
  AXIS
}

model RoleApplication {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedRole Role
  agencyName    String?
  walletAddress String? // wallet used for the $500 (Agent) / $5,000 (Agency) USDT mint, pending real on-chain verification
  paymentMethod MintPaymentMethod  @default(WALLET)
  status        ApplicationStatus  @default(PENDING)
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime           @default(now())

  @@index([userId])
}

// Records the 10% (Tier 1, direct referrer) / 5% (Tier 2, referrer's referrer)
// USDT commission owed when a referred user mints Agent or Agency. Paid out
// manually by an admin for now — see risk flag on custodial USDT payouts.
model MembershipCommission {
  id             String                      @id @default(cuid())
  recipientId    String
  recipient      User                        @relation("MembershipCommissionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  sourceUserId   String
  sourceUser     User                        @relation("MembershipCommissionSource", fields: [sourceUserId], references: [id], onDelete: Cascade)
  mintedRole     Role
  tier           CommissionTier
  usdtAmount     Decimal                     @db.Decimal(14, 2)
  status         MembershipCommissionStatus  @default(PENDING)
  createdAt      DateTime                    @default(now())

  @@index([recipientId])
}

// A user's request to add real money to their in-app USD balance. Nothing is
// actually charged here — no payment gateway is wired up yet. An admin
// confirms the payment came in (bank transfer / USDT deposit) and approves,
// which is what credits WalletLedgerEntry.
model WalletTopUpRequest {
  id           String              @id @default(cuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountUsd    Decimal             @db.Decimal(14, 2)
  method       WalletTopUpMethod
  note         String?
  status       WalletTopUpStatus   @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime            @default(now())

  @@index([userId])
}

// Append-only USD ledger — same idempotent pattern as PointsLedgerEntry.
// Balance = SUM(delta). Only approved top-ups and membership spends land here.
model WalletLedgerEntry {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Decimal       @db.Decimal(14, 2)
  reason    WalletReason
  refId     String?
  createdAt DateTime      @default(now())

  @@index([userId])
}

model Dispute {
  id             String        @id @default(cuid())
  raisedById     String
  raisedBy       User          @relation("DisputeRaisedBy", fields: [raisedById], references: [id])
  subjectType    String
  subjectId      String
  note           String
  status         DisputeStatus @default(OPEN)
  resolutionNote String?
  resolvedById   String?
  resolvedBy     User?         @relation("DisputeResolvedBy", fields: [resolvedById], references: [id])
  createdAt      DateTime      @default(now())
}

enum LiquidityReserveSource {
  MINT_FEE_ALLOCATION
  NODE_SALE_ALLOCATION
  ADMIN_ADJUST
}

// Dedicated, disciplined war chest for eventual $AXIS/USDT and $AXIS/PLS DEX
// liquidity — deliberately separate from general treasury so it isn't spent
// on anything else. Two funding sources, per the confirmed plan: (1) an
// automatic cut of every Agent/Agency mint fee, net of the 15% referral
// payout, taken the moment a mint is granted (see grantMembership in
// actions/roleApplication.ts); (2) a manually admin-logged share of the
// AxisPrestige node-sale proceeds (that $500/node sale happens off-platform
// on turbox.bond, so there's no in-app payment event to hook automatically —
// an admin records it once the real off-platform figures are known).
// Balance = SUM(amountUsd), same append-only ledger pattern as everything
// else here.
model LiquidityReserveEntry {
  id          String                 @id @default(cuid())
  amountUsd   Decimal                @db.Decimal(14, 2)
  source      LiquidityReserveSource
  refId       String?
  note        String?
  createdById String?
  createdAt   DateTime               @default(now())
}

enum MintCycleTarget {
  BURN
  AXIS_LIQUIDITY_RESERVE
  REFERRAL_TIER_1
  REFERRAL_TIER_2
}

// Audit trail for $AXIS-denominated Agent/Agency mints (the "mint-cycling"
// sink, confirmed design): AxisOne = 1,000,000 $AXIS, AxisPro = 10,000,000
// $AXIS (at the $0.0005 anchor). Referral is paid IN $AXIS on this path
// (10%/5%, same tier structure as the USDT path) rather than USDT, so the
// value never leaves the ecosystem. The remaining 85% splits 42.5% burned
// (permanently destroyed — never re-credited to anyone) / 42.5% into the
// $AXIS-denominated Liquidity Reserve. One row per target per mint, all
// summing to the full mint price paid.
model MintCycleLedgerEntry {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  role        Role
  target      MintCycleTarget
  amountAxis  Decimal         @db.Decimal(18, 4)
  recipientId String?
  createdAt   DateTime        @default(now())

  @@index([userId])
}

// ============================================================================
// Agent2Mine — Spend-to-Earn $AXIS mining, separate from the gamified
// PointsLedgerEntry system above. Real numbers confirmed: Agent2Mine
// Incentive Pool = 32% of 178B total $AXIS supply = 56.96B tokens, anchor
// price $0.0005 for this pool specifically, 60-month (5yr) vesting horizon.
// See src/lib/axisEmission.ts for the sinking-fund emission math this
// ledger feeds into.
// ============================================================================

enum AxisMiningTaskType {
  PETROL_RECEIPT
  META_ADS_ONBOARDING
}

enum AxisMiningStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED_DUPLICATE
}

enum MetaAdsCategory {
  PROPERTY_LOAN_LEADGEN
  GENERAL
}

enum AxisLedgerSource {
  AGENT2MINE_TASK
  AXISPRESTIGE_VESTING
  ADMIN_ADJUST
  MINT_CYCLE_PAYMENT
  MINT_CYCLE_REFERRAL
  CLAIM_VESTING_PAYOUT
}

enum VestingLockTier {
  SIX_MONTH
  ONE_YEAR
  TWO_YEAR
  THREE_YEAR
}

// A user's voluntary choice to lock a slice of their claimable (mined but
// unlocked) $AXIS into a fixed-term schedule in exchange for a higher payout
// %. grossAmount is deducted from claimable the instant this row is created
// (see getClaimableAxisBalance, which nets AGENT2MINE_TASK totals against
// SUM(grossAmount) across all schedules) — payoutAmount is what actually
// vests out linearly over lockMonths and becomes spendable via
// CLAIM_VESTING_PAYOUT ledger entries (see src/lib/axisClaimVesting.ts).
model AxisClaimVestingSchedule {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  grossAmount      Decimal         @db.Decimal(18, 4)
  payoutAmount     Decimal         @db.Decimal(18, 4)
  lockTier         VestingLockTier
  lockMonths       Int
  startedAt        DateTime        @default(now())
  cumulativeVested Decimal         @default(0) @db.Decimal(18, 4)
  createdAt        DateTime        @default(now())

  @@index([userId])
}

enum AxisRealizedValueSource {
  REVENUE_DISTRIBUTION
  TOKEN_SALE
  MARKETPLACE_REDEMPTION
}

// One row per Spend-to-Earn submission. Duplicate-receipt fraud detection
// (perceptualHash + receiptNumber, see src/lib/receiptFraud.ts) runs and can
// auto-flag before an admin ever reviews it. OCR-based field verification is
// NOT implemented — no vision API credentials — so merchantName/receiptNumber/
// subsidyAmountRm are user-entered and admin-verified against the uploaded
// image manually, same "pending manual review" pattern as KycSubmission.
model AxisMiningSubmission {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation("MiningSubmissionUser", fields: [userId], references: [id], onDelete: Cascade)
  taskType        AxisMiningTaskType
  status          AxisMiningStatus   @default(PENDING)
  blobPath        String

  // PETROL_RECEIPT fields
  merchantName    String?
  receiptNumber   String?
  subsidyAmountRm Decimal?           @db.Decimal(10, 2)
  perceptualHash  String?

  // META_ADS_ONBOARDING fields
  metaAdsCategory MetaAdsCategory?
  metaAdsSpendUsd Decimal?           @db.Decimal(10, 2)
  adSpendRm       Decimal?           @db.Decimal(10, 2)

  // Deposit mechanics (v2): approval no longer awards $AXIS directly — it
  // deposits depositValueRm (the subsidy amount for petrol, 10% of spend
  // for ads) into the user's personal MiningPoolLedgerEntry backlog, which
  // only becomes spendable $AXIS by completing tasks (see
  // src/lib/miningPool.ts). spendDate is the date shown on the
  // receipt/invoice — deposits are only valid for spend within the same
  // calendar month as submission, enforced against this field.
  spendDate       DateTime?
  depositValueRm  Decimal?           @db.Decimal(10, 2)
  axisDeposited   Decimal?           @db.Decimal(18, 4)

  axisAwarded     Decimal?           @db.Decimal(18, 4)
  duplicateOfId   String?
  reviewedById    String?
  reviewer        User?              @relation("MiningSubmissionReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime           @default(now())

  @@index([userId])
  @@index([perceptualHash])
  @@index([receiptNumber])
  @@index([status])
}

// Append-only $AXIS earnings ledger — same idempotent SUM(delta) pattern as
// PointsLedgerEntry/WalletLedgerEntry. Balance here represents tokens earned
// but not yet distributed on-chain (no wallet/contract integration in beta).
model AxisVestingLedgerEntry {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Decimal          @db.Decimal(18, 4)
  source    AxisLedgerSource
  refId     String?
  createdAt DateTime         @default(now())

  @@index([userId])
}

// Single configuration row for the Agent2Mine sinking-fund emission model.
// totalPoolTokens/vestingMonths/anchorPriceUsd are the confirmed real
// numbers; startDate anchors "how many months have elapsed" for the
// RemainingMonths term. Admin-editable in principle, but beta ships with one
// seeded row — see src/lib/axisEmission.ts.
model AxisMiningPoolConfig {
  id              String   @id @default(cuid())
  totalPoolTokens Decimal  @db.Decimal(20, 4)
  vestingMonths   Int
  startDate       DateTime
  anchorPriceUsd  Decimal  @db.Decimal(10, 6)
  createdAt       DateTime @default(now())
}

enum AxisPrestigePoolEntrySource {
  CASE_CONTRIBUTION
  ADMIN_ADJUST
  DISTRIBUTION_PAYOUT
}

// Running USD pool that funds AxisPrestige's quarterly revenue share.
// Positive delta = an admin logging real revenue from an actual converted
// case into the pool (per the confirmed rule — this is a real dollar
// figure tied to a real disbursed case, not an arbitrary number). Negative
// delta = drawn down when a quarterly distribution runs. Balance =
// SUM(delta), same append-only ledger pattern as everything else here.
model AxisPrestigeRevenuePoolEntry {
  id          String                      @id @default(cuid())
  amountUsd   Decimal                     @db.Decimal(14, 2)
  source      AxisPrestigePoolEntrySource
  caseId      String?
  note        String?
  createdById String?
  createdAt   DateTime                    @default(now())
}

// Quarterly REVENUE-SHARE distribution — paid in USD/USDT terms to the
// in-app wallet (WalletLedgerEntry), not in $AXIS. Distinct from the $AXIS
// token vesting below: this draws down the pool above and splits evenly
// across verified node holders, admin-triggered each quarter. Each line's
// amount also lands in AxisRealizedValueEntry (source REVENUE_DISTRIBUTION)
// since it counts toward the 25x realized-value burn cap on that node's
// token vesting — see src/lib/axisPrestigeVesting.ts.
model AxisPrestigeDistribution {
  id                  String                         @id @default(cuid())
  label               String
  totalDistributedUsd Decimal                        @db.Decimal(14, 2)
  createdById         String?
  createdAt           DateTime                       @default(now())

  lines AxisPrestigeDistributionLine[]
}

model AxisPrestigeDistributionLine {
  id             String                   @id @default(cuid())
  distributionId String
  distribution   AxisPrestigeDistribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  userId         String
  user           User                     @relation(fields: [userId], references: [id])
  nftHoldingId   String
  amountUsd      Decimal                  @db.Decimal(14, 2)

  @@index([distributionId])
  @@index([userId])
}

// One batch-audit record per $AXIS token vesting run, admin-triggered (not
// a real cron). totalCreditedTokens is a snapshot sum of that run's lines —
// see src/lib/axisPrestigeVesting.ts for how each node's newly-vested delta
// is computed and credited to AxisVestingLedgerEntry.
model AxisPrestigeVestingRun {
  id                   String                     @id @default(cuid())
  label                String
  totalCreditedTokens  Decimal                    @db.Decimal(20, 4)
  createdById          String?
  createdAt            DateTime                   @default(now())

  lines AxisPrestigeVestingRunLine[]
}

model AxisPrestigeVestingRunLine {
  id           String                 @id @default(cuid())
  runId        String
  run          AxisPrestigeVestingRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  userId       String
  user         User                   @relation(fields: [userId], references: [id])
  nftHoldingId String
  amount       Decimal                @db.Decimal(18, 4)

  @@index([runId])
  @@index([userId])
}

// Per-node vesting state. Created the moment an admin verifies a node claim
// (see reviewNodeVerification in actions/admin.ts). Confirmed real numbers:
// $500/node at the $0.0001 AxisPrestige anchor price = 5,000,000 $AXIS
// total allocation per node. 6-month cliff from verification, then linear
// daily vesting over 5 years — performanceMultiplier (from Agent2Mine task
// performance) speeds this up. cumulativeVested tracks what's already been
// credited to AxisVestingLedgerEntry so re-running the vesting batch only
// credits the newly-vested delta, never double-pays.
model AxisPrestigeNodeVesting {
  id                    String    @id @default(cuid())
  nftHoldingId          String    @unique
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  allocationTokens      Decimal   @db.Decimal(18, 4)
  verifiedAt            DateTime
  cliffMonths           Int       @default(6)
  vestingMonths         Int       @default(60)
  performanceMultiplier Float     @default(1.0)
  cumulativeVested      Decimal   @default(0) @db.Decimal(18, 4)
  burned                Boolean   @default(false)
  burnedAt              DateTime?
  createdAt             DateTime  @default(now())

  @@index([userId])
}

// Manually admin-recorded realized-value events — profit a node holder has
// already taken (revenue-distribution payouts, $AXIS sold for USDT,
// $AXIS spent on marketplace vouchers/services/RWA). No real custody/
// exchange integration exists yet, so this is entered by an admin, same
// "pending manual review" pattern as the rest of the app. Once a user's
// cumulative realized value hits 25x their $500 node cost ($12,500), their
// node's remaining unvested allocation is burned — see
// src/lib/axisPrestigeVesting.ts.
model AxisRealizedValueEntry {
  id        String                  @id @default(cuid())
  userId    String
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountUsd Decimal                 @db.Decimal(14, 2)
  source    AxisRealizedValueSource
  note      String?
  createdAt DateTime                @default(now())

  @@index([userId])
}

// ============================================================================
// Agent2Mine v2 — deposit pool + task-gated mine-out, per the confirmed
// design: Spend-to-Earn (petrol subsidy, ads spend) deposits real-world
// verified value into a personal backlog pool (RM-quota gated, same-
// calendar-month only, no rollover on exceeded quota), which only becomes
// spendable $AXIS by completing tasks — the withdrawal rate is a performance
// KPI (task volume), the ceiling is tier + Mining Power Multiplier weighted.
// See src/lib/miningPool.ts.
// ============================================================================

enum MiningPoolEntrySource {
  DEPOSIT      // petrol/ads deposit adds to the backlog
  TASK_MINEOUT // task completion withdraws from backlog into real AxisVestingLedgerEntry
}

// Personal backlog ledger. Balance = SUM(delta) = unmined $AXIS still
// waiting to be claimed. Deposits are a permanent claim — no expiry — but
// only mineable by actually doing tasks, gated by the mine-out cap.
model MiningPoolLedgerEntry {
  id        String                @id @default(cuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Decimal               @db.Decimal(18, 4)
  source    MiningPoolEntrySource
  refId     String?
  createdAt DateTime              @default(now())

  @@index([userId])
}

// Admin-editable config for the two genuinely volatile, external numbers
// that shouldn't be hardcoded: the government petrol subsidy rate (changes
// by policy announcement — see the fact-check flag on this) and the RM/USD
// FX rate used to convert RM deposit values into $AXIS at the pool's
// $0.0005 anchor. One live row; admin updates it in place.
// Single-row, admin-editable config for every tokenomics knob that started
// life as a hardcoded constant — see src/lib/miningConfig.ts. Values here
// only affect NEW calculations going forward (halving epoch, MPM, mint
// splits, lock-tier claims) — never retroactively rewritten into ledger
// rows or vesting schedules already created under the old numbers.
model AxisMiningConfig {
  id                     String   @id @default(cuid())
  petrolSubsidyRate      Float    @default(0.40)
  fxRateRmPerUsd         Float    @default(4.76)
  halvingMilestoneMiners Int      @default(17800)
  mpmBonusPerTierWeight  Float    @default(0.02)
  mpmCap                 Float    @default(0.5)
  adsDepositRate         Float    @default(0.10)
  mintBurnShare          Float    @default(0.425)
  mintReserveShare       Float    @default(0.425)
  lockSixMonthPayoutPct  Float    @default(0.30)
  lockOneYearPayoutPct   Float    @default(0.50)
  lockTwoYearPayoutPct   Float    @default(0.70)
  lockThreeYearPayoutPct Float    @default(1.00)
  updatedAt              DateTime @updatedAt
}

enum AesRevenueTarget {
  NODE_POOL_A       // 1% of AES net revenue — all verified node holders (1+ nodes)
  NODE_POOL_B       // 1% — node holders with 5+ nodes (in addition to Pool A)
  NODE_POOL_C       // 1% — node holders with 10+ nodes (in addition to A+B)
  BUYBACK_BURN      // 3.5% (50% of the remaining 7%) — real-world $AXIS buyback + burn
  STRATEGIC_RESERVE // 2.1% (30% of the remaining 7%) — crypto reserve
  OPERATIONS        // 1.4% (20% of the remaining 7%) — platform operations & growth
}

// AES net revenue (the broader Alphas Estate Solutions business — HQ sales
// plus branch/agency contributions, NOT just the 30% AES commission line
// item from loan disbursements, which is only one contributing stream) is a
// real consolidated figure that lives outside this platform's database, so
// an admin logs it manually — same "pending manual review" pattern as
// node-sale liquidity contributions. Logging one contribution auto-computes
// and records all six target splits from the fixed percentages above.
// Balance per target = SUM(amountUsd) WHERE target = X.
model AesRevenueLedgerEntry {
  id          String           @id @default(cuid())
  target      AesRevenueTarget
  amountUsd   Decimal          @db.Decimal(14, 2)
  note        String?
  createdById String?
  createdAt   DateTime         @default(now())
}

// One batch-audit record per Pool A/B/C distribution to qualifying node
// holders, evenly per person within each pool (a 10+ node holder qualifies
// for and receives a share of all three pools; a 1-4 node holder only Pool
// A). Paid to the in-app wallet (USD/USDT), same as the existing quarterly
// AxisPrestige revenue share.
model AesNodePoolDistribution {
  id          String   @id @default(cuid())
  target      AesRevenueTarget
  totalUsd    Decimal  @db.Decimal(14, 2)
  recipients  Int
  perPersonUsd Decimal @db.Decimal(14, 2)
  createdById String?
  createdAt   DateTime @default(now())

  lines AesNodePoolDistributionLine[]
}

model AesNodePoolDistributionLine {
  id             String                  @id @default(cuid())
  distributionId String
  distribution   AesNodePoolDistribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  userId         String
  user           User                    @relation(fields: [userId], references: [id])
  amountUsd      Decimal                 @db.Decimal(14, 2)

  @@index([distributionId])
  @@index([userId])
}
